# Example environment variables for local development
# Copy this file to .env and edit values as needed

ARSLM_API_HOST=0.0.0.0
ARSLM_API_PORT=8000
MODEL_PATH=./models/arslm_base.pt
ARSLM_ALLOWED_ORIGINS=http://localhost:8501
API_URL=http://localhost:8000

# Optional: paths used by training and RAG index
ARSLM_INDEX_PATH=./arslm_index
ARSLM_DRIVE_PATH=

# Dev settings
ENVIRONMENT=development
